{
  "schema_version": "agentlite.v514b.preregistration.v1",
  "frozen_before_provider_run": true,
  "experiment_kind": "preflight",
  "scenarios": [
    {
      "scenario_id": "A-preflight",
      "directory": "A"
    },
    {
      "scenario_id": "B-preflight",
      "directory": "B"
    }
  ],
  "groups": ["native", "observed", "managed"],
  "tasks_per_scenario": 3,
  "provider": {
    "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
    "model": "mimo-v2.5"
  },
  "temperature": 0,
  "max_turns": 9,
  "primary_cost_metrics": [
    "provider_llm_total_tokens",
    "end_to_end_collaboration_tokens"
  ],
  "diagnostic_cost_metrics": [
    "direct_message_tokens",
    "prompt_view_tokens",
    "retrieved_memory_tokens",
    "control_llm_tokens",
    "retry_tokens"
  ],
  "state_evidence_metrics": [
    "state_count",
    "state_type_counts",
    "payload_kind_counts",
    "structured_non_text_count",
    "contains_embedding_refs_count",
    "total_size_bytes"
  ],
  "quality_rule": "min(primary_blind_score, technical_blind_score)",
  "judge_usage_in_runtime_cost": false,
  "thresholds": {
    "managed_provider_token_reduction_min": 0.15,
    "managed_transport_token_reduction_min": 0.15,
    "managed_quality_noninferiority_margin": 0.3,
    "managed_delivery_complete_delta_min": 0,
    "rewrite_error_fallback_count_max": 0
  },
  "interpretation": {
    "evidence_pipeline_passed": "归档绑定、三组同口径、Provider usage、双盲质量和 AgentLite trace 均完整。",
    "preliminary_targets_met": "预检样本同时达到成本、质量、交付和运行时可靠性阈值。",
    "ready_for_formal_run": "只有证据管线和初步目标都通过，才进入 A1-A10/B1-B10 正式实验。"
  }
}
