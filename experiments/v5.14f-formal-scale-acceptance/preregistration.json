{
  "schema_version": "agentlite.v514f.preregistration.v1",
  "frozen_before_provider_run": true,
  "experiment_kind": "formal_scale_single_run",
  "source_lineage": {
    "mechanism_baseline": "v5.14e-current-task-fidelity-acceptance",
    "task_scope": "A1-A10 and B1-B10",
    "input_policy": "self_contained_frozen_synthetic_snapshots"
  },
  "scenarios": [
    {
      "scenario_id": "A-formal",
      "directory": "A",
      "terminal_task_id": "A10"
    },
    {
      "scenario_id": "B-formal",
      "directory": "B",
      "terminal_task_id": "B10"
    }
  ],
  "groups": ["native", "observed", "managed"],
  "tasks_per_scenario": 10,
  "provider": {
    "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
    "model": "mimo-v2.5"
  },
  "temperature": 0,
  "max_turns": 9,
  "primary_cost_metrics": [
    "provider_llm_total_tokens",
    "end_to_end_collaboration_tokens"
  ],
  "diagnostic_cost_metrics": [
    "direct_message_tokens",
    "prompt_view_tokens",
    "retrieved_memory_tokens",
    "control_llm_tokens",
    "retry_tokens"
  ],
  "state_evidence_metrics": [
    "state_count",
    "state_type_counts",
    "payload_kind_counts",
    "structured_non_text_count",
    "contains_embedding_refs_count",
    "total_size_bytes"
  ],
  "diagnostic_requested_state_types": [
    "retrieval_state",
    "embedding_state",
    "artifact_state"
  ],
  "quality_rule": "min(primary_blind_score, technical_blind_score)",
  "judge_usage_in_runtime_cost": false,
  "thresholds": {
    "managed_provider_token_reduction_min": 0.15,
    "managed_transport_token_reduction_min": 0.15,
    "managed_quality_noninferiority_margin": 0.3,
    "managed_delivery_complete_delta_min": 0,
    "rewrite_error_fallback_count_max": 0,
    "managed_terminal_score_min": 7.0,
    "managed_terminal_score_noninferiority_margin": 1.0,
    "managed_terminal_blocking_finding_count_max": 0,
    "memory_hit_count_min": 1,
    "memory_injected_count_min": 1,
    "useful_memory_hit_count_min": 1,
    "wrong_memory_hit_count_max": 0,
    "current_task_fidelity_failure_count_max": 0,
    "model_visible_protocol_marker_count_max": 0,
    "routing_metadata_state_count_max": 0
  },
  "interpretation": {
    "formal_scale_passed": "完整 20 任务证据、冻结成本质量阈值、终局交付和通用可靠性门禁同时通过。",
    "single_run_boundary": "本阶段是一次正式规模验收，不用于估计跨重复实验的方差或置信区间。",
    "state_type_boundary": "状态类型只从真实 StatePool 统计；任务要求中出现类型名称不等于运行时已生成该类型。"
  }
}
